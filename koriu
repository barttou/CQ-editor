import cadquery as cq

# Dimensiones del mango
body_length = 90
body_width = 30
body_height = 15

# Crear el cuerpo base
grip = (
    cq.Workplane("XY")
    .box(body_length, body_width, body_height)
    .edges("|Z").fillet(8)
    .edges("#Z").fillet(2)
)

# Exportar como STL
cq.exporters.export(grip, "ErgonomicKeyGrip_Base.stl")
print("Archivo STL exportado como ErgonomicKeyGrip_Base.stl")
